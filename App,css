* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #121212;
  color: white;
}

.spotify-clone {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.spotify-clone__body {
  display: flex;
  flex: 1;
  overflow: hidden;
}
